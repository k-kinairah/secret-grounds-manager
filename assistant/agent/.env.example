# Copy to assistant/agent/.env (gitignored) or set as real environment
# variables (real ones win). NEVER commit real keys.

# --- Service -----------------------------------------------------------------
# Port for the agent API (always bound to 127.0.0.1).
SG_AGENT_PORT=8781
# Our MCP server (assistant/mcp_server).
SG_MCP_URL=http://127.0.0.1:8765/mcp
# Browser origins allowed by CORS (comma-separated). The dashboard calls the agent
# server-side through its own /api/assistant route, so this only matters for direct
# browser testing against the dashboard dev server.
SG_AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Conversation memory: turns kept per session, and how many sessions to keep.
SG_AGENT_MAX_TURNS=20
SG_AGENT_MAX_SESSIONS=200
SG_AGENT_MAX_TOKENS=600
# SG_AGENT_TEMPERATURE=0.2

# --- Model provider: bedrock (default) | anthropic | openai | ollama ----------
SG_AGENT_PROVIDER=bedrock
# Model ID for the chosen provider (required), for example:
#   bedrock:   a model or inference-profile ID enabled in your account/region
#              (e.g. an Anthropic Claude or Amazon Nova model ID from the Bedrock console)
#   anthropic: an Anthropic API model ID (e.g. claude-sonnet-5-5)
#   openai:    an OpenAI model ID
#   ollama:    a locally pulled model tag (must support tool calling)
SG_AGENT_MODEL_ID=

# --- bedrock ------------------------------------------------------------------
# Region (default ap-southeast-2). Credentials come from the standard AWS chain:
# AWS_PROFILE (from `aws configure` / SSO), or AWS_ACCESS_KEY_ID +
# AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN). The identity needs
# bedrock:InvokeModelWithResponseStream on the model.
SG_AGENT_BEDROCK_REGION=ap-southeast-2
# AWS_PROFILE=

# --- anthropic ----------------------------------------------------------------
# ANTHROPIC_API_KEY=

# --- openai -------------------------------------------------------------------
# OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint instead of api.openai.com.
# SG_AGENT_OPENAI_BASE_URL=

# --- ollama -------------------------------------------------------------------
# SG_AGENT_OLLAMA_HOST=http://127.0.0.1:11434
