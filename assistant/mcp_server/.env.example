# Copy to assistant/mcp_server/.env (gitignored) or set these as real
# environment variables. Real environment variables win over this file.

# Must equal SG_ASSISTANT_TOKEN set on the backend. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SG_ASSISTANT_TOKEN=replace-with-a-long-random-token

# Backend the tools read from (dev default; do not point at production yet).
SG_BACKEND_URL=http://127.0.0.1:8000

# Port the MCP server listens on (always bound to 127.0.0.1).
SG_MCP_PORT=8765

# Shop timezone used to display times (matches the backend default).
SG_SHOP_TIMEZONE=Asia/Manila

# Seconds to wait for the backend before giving up.
SG_BACKEND_TIMEOUT_SECONDS=10
