# Development-only defaults for `npm run dev`. To override them on your own
# machine, copy this file to dashboard/.env.local (git-ignored, never committed).
# Nothing needs the copy: src/lib/api.ts falls back to these same values, and the
# production build takes its server address from config/.env instead.
NEXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000
NEXT_PUBLIC_POLL_INTERVAL_MS=4000
