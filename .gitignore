.venv/
runtime/
__pycache__/
*.pyc
.vscode/
node_modules/
.next/
dashboard/node_modules/
dashboard/.next/
dashboard/.env.production.local
*.tsbuildinfo
dashboard/dashboard-dev.log
config/.env
logs/*
!logs/.gitkeep
data/*.db
data/*.sqlite3
backups/*.db
# SQLite WAL mode writes -wal/-shm files beside every database, and they hold
# the same real shop data (members, sales). Ignore every database artifact by
# extension anywhere in the repo, and the whole backups folder, so a stray
# "git add ." can never publish them.
*.db
*.db-wal
*.db-shm
backups/

# Local Claude Code settings/launch configs -- per-machine, not project source.
.claude/

# Per-machine environment overrides. dashboard/.env.local used to be tracked;
# copy dashboard/.env.example to it if you want local overrides.
.env.local
.env.*.local
dist/
build/
*.spec
!SecretGroundsClient.spec
*.sqlite3
client_session_recovery.json
client_session_recovery.json.tmp
# Generated by install-client-autostart.ps1 next to itself -- on a real
# install that's outside the repo (Program Files), but running the script
# from a dev checkout for testing writes it straight into scripts/.
scripts/run-client-supervised-hidden.vbs

# Runtime-generated overlay HTML with cache-bust tokens (client/webview_ui.py)
client/web_ui/index.generated.html
